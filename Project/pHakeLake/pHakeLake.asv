% =========================================================================
% E80 ASV MASTER DEPLOYMENT ANALYSIS
% =========================================================================
clear; clc; close all;

%% --- 1. LOAD DATA ---
% Change this to match the file number you want to analyze!
filenum = '00'; 
logreader;

% The E80 main loop runs at 10Hz (every 100ms)
time_sec = (0:length(ch0)-1)' * 0.1; 

% Strip out the startup sequence (first 3 seconds) where sensors might be settling
stable_idx = find(time_sec > 3.0, 1, 'first');

%% --- 2. PREP GEOSPATIAL DATA (Filter out invalid GPS points) ---
% The GPS logs 0,0 before it gets a satellite lock. We must filter these out.
if exist('lat', 'var') && exist('lon', 'var')
    valid_gps = find(lat ~= 0 & lon ~= 0 & nsats >= 4 & time_sec > 3.0);
    map_lat = lat(valid_gps);
    map_lon = lon(valid_gps);
    map_temp_water = therm_water(valid_gps);
    has_gps = ~isempty(valid_gps);
else
    has_gps = false;
end

%% --- FIGURE 1: SPATIAL MAP (Zoomed-Out Continuous Gradient Line) ---
if has_gps
    figure('Name', 'Spatial Map', 'Position', [50, 100, 800, 600]);
    gx = geoaxes;
    geobasemap(gx, 'satellite'); 
    hold on;

    % Setup the colormap for the gradient
    cmap = turbo(256);
    temp_min = min(map_temp_water);
    temp_max = max(map_temp_water);
    if temp_max == temp_min; temp_max = temp_min + 1; end % Prevent division by zero

    % Draw the continuous gradient line by linking points
    for i = 1:(length(map_lat)-1)
        val = map_temp_water(i);
        color_idx = round(255 * (val - temp_min) / (temp_max - temp_min)) + 1;
        color_idx = max(1, min(256, color_idx)); 
        geoplot(gx, map_lat(i:i+1), map_lon(i:i+1), 'Color', cmap(color_idx,:), 'LineWidth', 4);
    end

    colormap(gx, turbo);
    caxis(gx, [temp_min temp_max]);
    c = colorbar(gx);
    c.Label.String = 'Water Temperature (°C)';
    c.Label.FontSize = 12;

    % ZOOM OUT: Add a 50% buffer around the bounds of your GPS path
    lat_pad = max(0.0002, (max(map_lat) - min(map_lat)) * 0.5);
    lon_pad = max(0.0002, (max(map_lon) - min(map_lon)) * 0.5);
    geolimits(gx, [min(map_lat)-lat_pad, max(map_lat)+lat_pad], ...
                  [min(map_lon)-lon_pad, max(map_lon)+lon_pad]);

    title('ASV Trajectory & Temperature Gradient Line');
    hold off;
else
    disp('No valid GPS lock found in this dataset. Skipping maps.');
end

%% --- FIGURE 2: ENVIRONMENTAL TIME SERIES ---
figure('Name', 'Environmental Sensors', 'Position', [100, 150, 1000, 600]);

% Wind Velocity
subplot(2, 1, 1);
plot(time_sec(stable_idx:end), wind_vel(stable_idx:end), 'b-', 'LineWidth', 1.5);
xlabel('Time (s)'); ylabel('Wind Velocity (m/s)');
title('Anemometer Data');
grid on;

% Thermistors (Air vs Water)
subplot(2, 1, 2);
plot(time_sec(stable_idx:end), therm_air(stable_idx:end), 'r-', 'LineWidth', 1.5, 'DisplayName', 'Air Temp');
hold on;
plot(time_sec(stable_idx:end), therm_water(stable_idx:end), 'b-', 'LineWidth', 1.5, 'DisplayName', 'Water Temp');
xlabel('Time (s)'); ylabel('Temperature (°C)');
title('Thermistor Data');
legend('Location', 'best');
grid on;

%% --- FIGURE 3: SUNDIAL SENSOR ARRAY ---
figure('Name', 'Sundial Diagnostics', 'Position', [150, 200, 1000, 600]);

% Group the 16 channels
pt_data = [ch0, ch1, ch2, ch3, ch4, ch5, ch6, ch7, ch8, ch9, ch10, ch11, ch12, ch13, ch14, ch15];
pt_data = pt_data(stable_idx:end, :);
plot_time = time_sec(stable_idx:end);

% Heatmap of the shadow moving across the array
subplot(2, 1, 1);
imagesc(plot_time, 0:15, pt_data'); 
set(gca, 'YDir', 'normal'); 
colormap(gca, 'parula'); 
c3 = colorbar; c3.Label.String = 'Voltage (V)';
title('Sundial Array Heatmap (Dark blue = Shadow)');
xlabel('Time (s)'); ylabel('Sensor Channel (0=Front)');
yticks(0:15);

% Raw Voltages Plot
subplot(2, 1, 2);
plot(plot_time, pt_data, 'LineWidth', 1);
title('Raw Phototransistor Voltages');
xlabel('Time (s)'); ylabel('Voltage (V)');
grid on;

%% --- FIGURE 4: CONTROL & NAVIGATION DIAGNOSTICS ---
figure('Name', 'Control Systems', 'Position', [200, 250, 1000, 600]);

% Plot IMU Heading - Left the Y-axis alone so negative values show up!
subplot(2, 1, 1);
if exist('heading', 'var')
    plot(time_sec(stable_idx:end), heading(stable_idx:end), 'k-', 'LineWidth', 1.5);
elseif exist('headingIMU', 'var')
    plot(time_sec(stable_idx:end), headingIMU(stable_idx:end), 'k-', 'LineWidth', 1.5);
end
xlabel('Time (s)'); ylabel('Heading (Degrees)');
title('IMU True Heading');
grid on;

% Plot Surface Control PI Error
subplot(2, 1, 2);
if exist('yaw', 'var') && exist('yaw_des', 'var')
    plot(time_sec(stable_idx:end), rad2deg(yaw_des(stable_idx:end)), 'r--', 'LineWidth', 2, 'DisplayName', 'Target Yaw');
    hold on;
    plot(time_sec(stable_idx:end), rad2deg(yaw(stable_idx:end)), 'b-', 'LineWidth', 1.5, 'DisplayName', 'Actual Yaw');
    xlabel('Time (s)'); ylabel('Yaw (Degrees)');
    title('Closed-Loop Controller Performance (Phase 2/3)');
    legend('Location', 'best');
    grid on;
else
    title('No Control Data (yaw/yaw_des) found in this log.');
end